+package io.github.eipx.remoteagent.modules.core;
+
+import static org.junit.Assert.*;
+import static org.junit.Assume.assumeTrue;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.Mockito.*;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.lang.reflect.Field;
+import java.net.URI;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.Arrays;
+
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.mockito.ArgumentCaptor;
+
+import com.sun.net.httpserver.Headers;
+import com.sun.net.httpserver.HttpExchange;
+
+import io.github.eipx.remoteagent.http.Session;
+import io.github.eipx.remoteagent.modules.ModuleManager;
+import io.github.eipx.remoteagent.rest.RESTUtil;
+
+/**
+ * Unit tests for {@link FSRESTModuleImpl}. Only the {@link HttpExchange} is
+ * mocked; the handlers run against the real {@link FSModuleImpl} on a
+ * temporary directory, so the status mapping is proven against actual
+ * {@code java.io.File} behaviour rather than a stub. The two registration
+ * tests mock the module manager to pin the session-parity decision.
+ */
+public class FSRESTModuleImplTest
+{
+    @Rule
+    public TemporaryFolder tmp = new TemporaryFolder();
+
+    private FSRESTModuleImpl facade;
+    private Session session;
+
+    /** Mocked exchange plus the stream its response body is written to. */
+    private static final class Call
+    {
+        final HttpExchange exchange;
+        final ByteArrayOutputStream out;
+        Call(final HttpExchange exchange, final ByteArrayOutputStream out) { this.exchange = exchange; this.out = out; }
+    }
+
+    @Before
+    public void setUp() throws Exception
+    {
+        facade = new FSRESTModuleImpl();
+        session = new Session() {};
+        // Wire the real domain module directly — same package, bypass load()
+        Field f = FSRESTModuleImpl.class.getDeclaredField("fsModuleImpl");
+        f.setAccessible(true);
+        f.set(facade, new FSModuleImpl());
+    }
+
+    // -- Helpers --
+
+    private static String enc(final String s) throws Exception
+    {
+        return URLEncoder.encode(s, "UTF-8");
+    }
+
+    private Call call(final String method, final String query, final byte[] body) throws Exception
+    {
+        return call(method, query, new ByteArrayInputStream(body), body.length);
+    }
+
+    private Call call(final String method, final String query, final InputStream body, final long declaredLength) throws Exception
+    {
+        HttpExchange ex = mock(HttpExchange.class);
+        Headers requestHeaders = new Headers();
+        if(declaredLength >= 0) requestHeaders.set("Content-Length", String.valueOf(declaredLength));
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        when(ex.getRequestMethod()).thenReturn(method);
+        when(ex.getRequestURI()).thenReturn(new URI("/agent/sessions/" + RESTUtil.encodeToken(session.getID()) + "/fs/x" + (query == null ? "" : "?" + query)));
+        when(ex.getRequestHeaders()).thenReturn(requestHeaders);
+        when(ex.getResponseHeaders()).thenReturn(new Headers());
+        when(ex.getRequestBody()).thenReturn(body);
+        when(ex.getResponseBody()).thenReturn(out);
+        return new Call(ex, out);
+    }
+
+    private static int status(final Call c) throws IOException
+    {
+        ArgumentCaptor<Integer> status = ArgumentCaptor.forClass(Integer.class);
+        verify(c.exchange).sendResponseHeaders(status.capture(), anyLong());
+        return status.getValue();
+    }
+
+    private static String body(final Call c)
+    {
+        return new String(c.out.toByteArray(), StandardCharsets.UTF_8);
+    }
+
+    private void dispatch(final Call c, final String... segments) throws Throwable
+    {
+        facade.handle(c.exchange, session, segments);
+    }
+
+    private File file(final String name, final String content) throws Exception
+    {
+        File f = tmp.newFile(name);
+        Files.write(f.toPath(), content.getBytes(StandardCharsets.UTF_8));
+        return f;
+    }
+
+    // -- entries (stat) --
+
+    @Test
+    public void stat_file_reportsTypeAndSize() throws Throwable
+    {
+        File f = file("a.txt", "hello");
+        Call c = call("GET", "path=" + enc(f.getAbsolutePath()), new byte[0]);
+        dispatch(c, "entries");
+        assertEquals(200, status(c));
+        String b = body(c);
+        assertTrue(b, b.contains("\"exists\":true"));
+        assertTrue(b, b.contains("\"type\":\"file\""));
+        assertTrue(b, b.contains("\"size\":5"));
+    }
+
+    @Test
+    public void stat_directory_reportsType() throws Throwable
+    {
+        Call c = call("GET", "path=" + enc(tmp.getRoot().getAbsolutePath()), new byte[0]);
+        dispatch(c, "entries");
+        assertEquals(200, status(c));
+        assertTrue(body(c).contains("\"type\":\"directory\""));
+    }
+
+    @Test
+    public void stat_missing_is200WithExistsFalse() throws Throwable
+    {
+        Call c = call("GET", "path=" + enc(new File(tmp.getRoot(), "nope").getAbsolutePath()), new byte[0]);
+        dispatch(c, "entries");
+        assertEquals(200, status(c));
+        assertTrue(body(c).contains("\"exists\":false"));
+    }
+
+    @Test
+    public void stat_missingPathParameter_returns400() throws Throwable
+    {
+        Call c = call("GET", null, new byte[0]);
+        dispatch(c, "entries");
+        assertEquals(400, status(c));
+    }
+
+    // -- files: read --
+
+    @Test
+    public void readFile_returnsBytesAsOctetStream() throws Throwable
+    {
+        File f = file("a.txt", "hello");
+        Call c = call("GET", "path=" + enc(f.getAbsolutePath()), new byte[0]);
+        dispatch(c, "files");
+        assertEquals(200, status(c));
+        assertEquals("application/octet-stream", c.exchange.getResponseHeaders().getFirst("Content-Type"));
+        assertEquals("hello", body(c));
+    }
+
+    @Test
+    public void readFile_emptyFile_returns200WithEmptyBody() throws Throwable
+    {
+        File f = tmp.newFile("empty.txt");
+        Call c = call("GET", "path=" + enc(f.getAbsolutePath()), new byte[0]);
+        dispatch(c, "files");
+        assertEquals(200, status(c));
+        assertEquals("", body(c));
+    }
+
+    @Test
+    public void readFile_window_returnsOffsetAndLength() throws Throwable
+    {
+        File f = file("a.txt", "0123456789");
+        Call c = call("GET", "path=" + enc(f.getAbsolutePath()) + "&offset=3&length=4", new byte[0]);
+        dispatch(c, "files");
+        assertEquals(200, status(c));
+        assertEquals("3456", body(c));
+    }
+
+    @Test
+    public void readFile_negativeOffset_returns400() throws Throwable
+    {
+        File f = file("a.txt", "x");
+        Call c = call("GET", "path=" + enc(f.getAbsolutePath()) + "&offset=-1", new byte[0]);
+        dispatch(c, "files");
+        assertEquals(400, status(c));
+    }
+
+    @Test
+    public void readFile_zeroLength_returns400() throws Throwable
+    {
+        File f = file("a.txt", "x");
+        Call c = call("GET", "path=" + enc(f.getAbsolutePath()) + "&length=0", new byte[0]);
+        dispatch(c, "files");
+        assertEquals(400, status(c));
+    }
+
+    @Test
+    public void readFile_missing_returns404() throws Throwable
+    {
+        Call c = call("GET", "path=" + enc(new File(tmp.getRoot(), "nope.txt").getAbsolutePath()), new byte[0]);
+        dispatch(c, "files");
+        assertEquals(404, status(c));
+    }
+
+    @Test
+    public void readFile_unreadable_returns403() throws Throwable
+    {
+        File f = file("secret.txt", "x");
+        // Not enforceable for privileged users or on some file systems; skip rather than fail there.
+        assumeTrue(f.setReadable(false, false) && !f.canRead());
+        Call c = call("GET", "path=" + enc(f.getAbsolutePath()), new byte[0]);
+        dispatch(c, "files");
+        assertEquals(403, status(c));
+    }
+
+    @Test
+    public void readFile_pathWithPlusAndPercent_isDecodedOnce() throws Throwable
+    {
+        File f = file("a+b%20c.txt", "plus");
+        Call c = call("GET", "path=" + enc(f.getAbsolutePath()), new byte[0]);
+        dispatch(c, "files");
+        assertEquals(200, status(c));
+        assertEquals("plus", body(c));
+    }
+
+    // -- files: write --
+
+    @Test
+    public void writeFile_new_returns201AndWritesContent() throws Throwable
+    {
+        File f = new File(tmp.getRoot(), "new.txt");
+        Call c = call("PUT", "path=" + enc(f.getAbsolutePath()), "payload".getBytes(StandardCharsets.UTF_8));
+        dispatch(c, "files");
+        assertEquals(201, status(c));
+        assertEquals("payload", new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8));
+    }
+
+    @Test
+    public void writeFile_existing_returns200AndOverwrites() throws Throwable
+    {
+        File f = file("a.txt", "old-content");
+        Call c = call("PUT", "path=" + enc(f.getAbsolutePath()), "new".getBytes(StandardCharsets.UTF_8));
+        dispatch(c, "files");
+        assertEquals(200, status(c));
+        assertEquals("new", new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8));
+    }
+
+    @Test
+    public void writeFile_emptyBody_createsEmptyFile() throws Throwable
+    {
+        File f = new File(tmp.getRoot(), "empty.txt");
+        Call c = call("PUT", "path=" + enc(f.getAbsolutePath()), new byte[0]);
+        dispatch(c, "files");
+        assertEquals(201, status(c));
+        assertEquals(0, f.length());
+    }
+
+    @Test
+    public void writeFile_bodyDeliveredInSmallChunks_isWrittenWhole() throws Throwable
+    {
+        // A stream that hands out one byte per read(): a single-read helper would truncate this.
+        final byte[] data = new byte[10 * 1024];
+        Arrays.fill(data, (byte) 'z');
+        InputStream trickle = new InputStream()
+        {
+            private int i = 0;
+            @Override public int read() { return (i < data.length) ? (data[i++] & 0xff) : -1; }
+            @Override public int read(final byte[] b, final int off, final int len) { int v = read(); if(v < 0) return -1; b[off] = (byte) v; return 1; }
+        };
+        File f = new File(tmp.getRoot(), "big.txt");
+        Call c = call("PUT", "path=" + enc(f.getAbsolutePath()), trickle, data.length);
+        dispatch(c, "files");
+        assertEquals(201, status(c));
+        assertEquals(data.length, f.length());
+    }
+
+    @Test
+    public void writeFile_declaredLengthOverLimit_returns413() throws Throwable
+    {
+        File f = new File(tmp.getRoot(), "huge.txt");
+        Call c = call("PUT", "path=" + enc(f.getAbsolutePath()), new ByteArrayInputStream(new byte[0]), Long.MAX_VALUE);
+        dispatch(c, "files");
+        assertEquals(413, status(c));
+        assertFalse(f.exists());
+    }
+
+    @Test
+    public void writeFile_malformedContentLength_returns400() throws Throwable
+    {
+        File f = new File(tmp.getRoot(), "x.txt");
+        Call c = call("PUT", "path=" + enc(f.getAbsolutePath()), new ByteArrayInputStream(new byte[0]), -1);
+        c.exchange.getRequestHeaders().set("Content-Length", "not-a-number");
+        dispatch(c, "files");
+        assertEquals(400, status(c));
+    }
+
+    @Test
+    public void writeFile_parentMissing_returns409() throws Throwable
+    {
+        File f = new File(new File(tmp.getRoot(), "missing-dir"), "x.txt");
+        Call c = call("PUT", "path=" + enc(f.getAbsolutePath()), "x".getBytes(StandardCharsets.UTF_8));
+        dispatch(c, "files");
+        assertEquals(409, status(c));
+    }
+
+    // -- files: remove --
+
+    @Test
+    public void removeFile_returns200ThenRepeat404() throws Throwable
+    {
+        File f = file("a.txt", "x");
+        Call first = call("DELETE", "path=" + enc(f.getAbsolutePath()), new byte[0]);
+        dispatch(first, "files");
+        assertEquals(200, status(first));
+        assertFalse(f.exists());
+        Call second = call("DELETE", "path=" + enc(f.getAbsolutePath()), new byte[0]);
+        dispatch(second, "files");
+        assertEquals(404, status(second));
+    }
+
+    // -- files: copy / move --
+
+    @Test
+    public void copyFile_returns201WithLocation() throws Throwable
+    {
+        File src = file("src.txt", "copy-me");
+        File dst = new File(tmp.getRoot(), "dst.txt");
+        String json = "{\"source\":\"" + escape(src.getAbsolutePath()) + "\",\"destination\":\"" + escape(dst.getAbsolutePath()) + "\"}";
+        Call c = call("POST", null, json.getBytes(StandardCharsets.UTF_8));
+        dispatch(c, "files", "copy");
+        assertEquals(201, status(c));
+        String location = c.exchange.getResponseHeaders().getFirst("Location");
+        assertNotNull(location);
+        assertTrue(location, location.startsWith(AbstractRESTModule.SESSION_CONTEXT_PATH + "/" + RESTUtil.encodeToken(session.getID()) + "/fs/files?path="));
+        assertEquals("copy-me", new String(Files.readAllBytes(dst.toPath()), StandardCharsets.UTF_8));
+        assertTrue(src.exists());
+    }
+
+    @Test
+    public void copyFile_missingSource_returns404() throws Throwable
+    {
+        String json = "{\"source\":\"" + escape(new File(tmp.getRoot(), "nope").getAbsolutePath()) + "\",\"destination\":\"" + escape(new File(tmp.getRoot(), "d").getAbsolutePath()) + "\"}";
+        Call c = call("POST", null, json.getBytes(StandardCharsets.UTF_8));
+        dispatch(c, "files", "copy");
+        assertEquals(404, status(c));
+    }
+
+    @Test
+    public void copyFile_badJson_returns400() throws Throwable
+    {
+        Call c = call("POST", null, "{not json".getBytes(StandardCharsets.UTF_8));
+        dispatch(c, "files", "copy");
+        assertEquals(400, status(c));
+    }
+
+    @Test
+    public void moveFile_returns200AndSourceIsGone() throws Throwable
+    {
+        File src = file("src.txt", "move-me");
+        File dst = new File(tmp.getRoot(), "moved.txt");
+        String json = "{\"source\":\"" + escape(src.getAbsolutePath()) + "\",\"destination\":\"" + escape(dst.getAbsolutePath()) + "\"}";
+        Call c = call("POST", null, json.getBytes(StandardCharsets.UTF_8));
+        dispatch(c, "files", "move");
+        assertEquals(200, status(c));
+        assertFalse(src.exists());
+        assertEquals("move-me", new String(Files.readAllBytes(dst.toPath()), StandardCharsets.UTF_8));
+    }
+
+    @Test
+    public void moveDirectory_isAllowed() throws Throwable
+    {
+        File src = tmp.newFolder("srcdir");
+        File dst = new File(tmp.getRoot(), "dstdir");
+        String json = "{\"source\":\"" + escape(src.getAbsolutePath()) + "\",\"destination\":\"" + escape(dst.getAbsolutePath()) + "\"}";
+        Call c = call("POST", null, json.getBytes(StandardCharsets.UTF_8));
+        dispatch(c, "files", "move");
+        assertEquals(200, status(c));
+        assertTrue(dst.isDirectory());
+    }
+
+    // -- directories --
+
+    @Test
+    public void listDirectory_returnsEntries() throws Throwable
+    {
+        File dir = tmp.newFolder("d");
+        file("d/one.txt", "1");
+        file("d/two.txt", "2");
+        Call c = call("GET", "path=" + enc(dir.getAbsolutePath()), new byte[0]);
+        dispatch(c, "directories");
+        assertEquals(200, status(c));
+        String b = body(c);
+        assertTrue(b, b.contains("one.txt") && b.contains("two.txt"));
+    }
+
+    @Test
+    public void listDirectory_empty_returnsEmptyArray() throws Throwable
+    {
+        File dir = tmp.newFolder("empty");
+        Call c = call("GET", "path=" + enc(dir.getAbsolutePath()), new byte[0]);
+        dispatch(c, "directories");
+        assertEquals(200, status(c));
+        assertTrue(body(c).contains("\"entries\":[]"));
+    }
+
+    @Test
+    public void listDirectory_onFile_returns404() throws Throwable
+    {
+        File f = file("a.txt", "x");
+        Call c = call("GET", "path=" + enc(f.getAbsolutePath()), new byte[0]);
+        dispatch(c, "directories");
+        assertEquals(404, status(c));
+    }
+
+    @Test
+    public void makeDirectory_returns201ThenRepeat200() throws Throwable
+    {
+        File dir = new File(tmp.getRoot(), "newdir");
+        Call first = call("PUT", "path=" + enc(dir.getAbsolutePath()), new byte[0]);
+        dispatch(first, "directories");
+        assertEquals(201, status(first));
+        assertTrue(dir.isDirectory());
+        Call second = call("PUT", "path=" + enc(dir.getAbsolutePath()), new byte[0]);
+        dispatch(second, "directories");
+        assertEquals(200, status(second));
+    }
+
+    @Test
+    public void makeDirectory_parentMissing_returns409() throws Throwable
+    {
+        File dir = new File(new File(tmp.getRoot(), "no-parent"), "child");
+        Call c = call("PUT", "path=" + enc(dir.getAbsolutePath()), new byte[0]);
+        dispatch(c, "directories");
+        assertEquals(409, status(c));
+    }
+
+    @Test
+    public void removeDirectory_returns200() throws Throwable
+    {
+        File dir = tmp.newFolder("gone");
+        Call c = call("DELETE", "path=" + enc(dir.getAbsolutePath()), new byte[0]);
+        dispatch(c, "directories");
+        assertEquals(200, status(c));
+        assertFalse(dir.exists());
+    }
+
+    @Test
+    public void removeDirectory_nonEmpty_returns409() throws Throwable
+    {
+        File dir = tmp.newFolder("full");
+        file("full/x.txt", "x");
+        Call c = call("DELETE", "path=" + enc(dir.getAbsolutePath()), new byte[0]);
+        dispatch(c, "directories");
+        assertEquals(409, status(c));
+        assertTrue(dir.exists());
+    }
+
+    @Test
+    public void removeDirectory_missing_returns404() throws Throwable
+    {
+        Call c = call("DELETE", "path=" + enc(new File(tmp.getRoot(), "nope").getAbsolutePath()), new byte[0]);
+        dispatch(c, "directories");
+        assertEquals(404, status(c));
+    }
+
+    // -- routing --
+
+    @Test
+    public void unknownPath_returns404() throws Throwable
+    {
+        Call c = call("GET", null, new byte[0]);
+        dispatch(c, "nonexistent");
+        assertEquals(404, status(c));
+    }
+
+    @Test
+    public void wrongMethod_returns405() throws Throwable
+    {
+        Call c = call("POST", "path=" + enc(tmp.getRoot().getAbsolutePath()), new byte[0]);
+        dispatch(c, "files");
+        assertEquals(405, status(c));
+    }
+
+    // -- helpers --
+
+    private static String escape(final String s)
+    {
+        return s.replace("\\", "\\\\").replace("\"", "\\\"");
+    }
+    // -- registration: session parity with the SOAP endpoint --
+
+    @Test
+    public void load_registersTheNamespaceWithASessionRequired() throws Throwable
+    {
+        ModuleManager manager = mock(ModuleManager.class);
+        RESTModuleImpl rest = mock(RESTModuleImpl.class);
+        FSRESTModuleImpl module = new FSRESTModuleImpl();
+        when(manager.getModule(RESTModuleImpl.class)).thenReturn(rest);
+        when(manager.getModule(FSModuleImpl.class)).thenReturn(new FSModuleImpl());
+        when(rest.registerNamespace(FSRESTModuleImpl.FS_NAMESPACE, module, true)).thenReturn(true);
+
+        assertTrue(module.load(manager));
+        verify(rest).registerNamespace(FSRESTModuleImpl.FS_NAMESPACE, module, true);
+
+        assertTrue(module.unload(manager));
+        verify(rest).unregisterNamespace(FSRESTModuleImpl.FS_NAMESPACE);
+    }
+
+    @Test
+    public void load_failsWhenTheNamespaceCannotBeRegistered() throws Throwable
+    {
+        ModuleManager manager = mock(ModuleManager.class);
+        RESTModuleImpl rest = mock(RESTModuleImpl.class);
+        FSRESTModuleImpl module = new FSRESTModuleImpl();
+        when(manager.getModule(RESTModuleImpl.class)).thenReturn(rest);
+        when(manager.getModule(FSModuleImpl.class)).thenReturn(new FSModuleImpl());
+        when(rest.registerNamespace(FSRESTModuleImpl.FS_NAMESPACE, module, true)).thenReturn(false);
+
+        assertFalse(module.load(manager));
+    }
+}

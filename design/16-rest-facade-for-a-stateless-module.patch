+        if(declaredLength >= 0) requestHeaders.set("Content-Length", String.valueOf(declaredLength));
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        when(ex.getRequestMethod()).thenReturn(method);
+        when(ex.getRequestURI()).thenReturn(new URI("/agent/sessions/" + RESTUtil.encodeToken(session.getID()) + "/fs/x" + (query == null ? "" : "?" + query)));

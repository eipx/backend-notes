         exchange.getResponseBody().close();
     }
+
+    /**
+     * Sends raw bytes with the given content type. A {@code null} payload is
+     * treated as zero-length, and an empty payload is sent with no body
+     * ({@code -1}) rather than a zero length, which the JDK server would treat
+     * as "chunked, unknown length". Callers that want {@code 204} should use
+     * {@link #sendNoContent} instead.
+     *
+     * @param exchange    The HTTP exchange on which to send the response.
+     * @param statusCode  The HTTP status code.
+     * @param bytes       The payload, or {@code null}.
+     * @param contentType The {@code Content-Type} header value.
+     * @throws IOException
+     */
+    public static void sendBinaryResponse(final HttpExchange exchange, final int statusCode,
+                                          final byte[] bytes, final String contentType) throws IOException
+    {
+        byte[] body = (bytes != null) ? bytes : new byte[0];
+        exchange.getResponseHeaders().set("Content-Type", contentType);
+        exchange.sendResponseHeaders(statusCode, body.length == 0 ? -1 : body.length);
+        try(OutputStream os = exchange.getResponseBody()) { os.write(body); }
+    }

+package io.github.eipx.remoteagent.modules.core;
+
+import static org.junit.Assert.*;
+import static org.mockito.Mockito.mock;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.Before;
+import org.junit.Test;
+
+import com.sun.net.httpserver.HttpContext;
+import io.github.eipx.remoteagent.rest.RESTNamespaceHandler;
+
+/**
+ * Unit tests for the namespace registry of {@link RESTModuleImpl}: both
+ * kinds of mount ({@code requireSession} true and false) through the one
+ * API. The HTTP context binding is stubbed through the protected hooks so
+ * that no server is needed; the stub records what was bound and unbound.
+ */
+public class RESTModuleImplNamespaceTest
+{
+    private RESTModuleImpl module;
+    private final RESTNamespaceHandler handler = (exchange, session, segments) -> {};
+    private final List<String> bound = new ArrayList<String>();
+    private final List<HttpContext> unbound = new ArrayList<HttpContext>();
+
+    @Before
+    public void setUp()
+    {
+        module = new RESTModuleImpl()
+        {
+            @Override protected HttpContext addNamespaceContext(final String namespace)
+            {
+                bound.add(namespace);
+                return mock(HttpContext.class);
+            }
+            @Override protected void removeNamespaceContext(final HttpContext httpContext)
+            {
+                unbound.add(httpContext);
+            }
+        };
+    }
+
+    // -- registration --
+
+    @Test
+    public void registersSessionScopedNamespaceWithoutBindingAContext()
+    {
+        assertTrue(module.registerNamespace("link", handler, true));
+        assertTrue("a session-scoped namespace lives under /agent/sessions and binds nothing", bound.isEmpty());
+    }
+
+    @Test
+    public void registersRootNamespaceAndBindsItsContext()
+    {
+        assertTrue(module.registerNamespace("fs", handler, false));
+        assertEquals(1, bound.size());
+        assertEquals("fs", bound.get(0));
+    }
+
+    @Test
+    public void rejectsReservedSessionScopedNamespace()
+    {
+        assertFalse("processes is a core session route", module.registerNamespace("processes", handler, true));
+    }
+
+    @Test
+    public void rejectsReservedRootNamespaces()
+    {
+        assertFalse(module.registerNamespace("sessions", handler, false));
+        assertFalse(module.registerNamespace("admin", handler, false));
+        assertTrue(bound.isEmpty());
+    }
+
+    @Test
+    public void rejectsMalformedNamespaces()
+    {
+        assertFalse(module.registerNamespace(null, handler, false));
+        assertFalse(module.registerNamespace("", handler, true));
+        assertFalse(module.registerNamespace("a/b", handler, false));
+        assertFalse(module.registerNamespace("*", handler, true));
+    }
+
+    @Test
+    public void rejectsNullHandler()
+    {
+        assertFalse(module.registerNamespace("fs", null, false));
+    }
+
+    @Test
+    public void rejectsDuplicateRegistrationAcrossKinds()
+    {
+        assertTrue(module.registerNamespace("x", handler, true));
+        assertFalse("same name as a root namespace", module.registerNamespace("x", handler, false));
+        assertFalse("same name again as session-scoped", module.registerNamespace("x", handler, true));
+    }
+
+    // -- unregistration --
+
+    @Test
+    public void unregisterRemovesTheContextOfARootNamespace()
+    {
+        assertTrue(module.registerNamespace("fs", handler, false));
+        assertTrue(module.unregisterNamespace("fs"));
+        assertEquals(1, unbound.size());
+    }
+
+    @Test
+    public void unregisterOfASessionScopedNamespaceUnbindsNothing()
+    {
+        assertTrue(module.registerNamespace("link", handler, true));
+        assertTrue(module.unregisterNamespace("link"));
+        assertTrue(unbound.isEmpty());
+    }
+
+    @Test
+    public void unregisterFreesTheNameForEitherKind()
+    {
+        assertTrue(module.registerNamespace("x", handler, false));
+        assertTrue(module.unregisterNamespace("x"));
+        assertTrue(module.registerNamespace("x", handler, true));
+    }
+
+    @Test
+    public void unregisterUnknownReturnsFalse()
+    {
+        assertFalse(module.unregisterNamespace("never-registered"));
+        assertFalse(module.unregisterNamespace(null));
+    }
+}

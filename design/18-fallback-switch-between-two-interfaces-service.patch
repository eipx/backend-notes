+def update_saf_hc2basic(session, request, preview):
+    """
+    Switch SAF traffic from HC to Basic, and conversely from Basic to HC:
+    without an explicit queue list only the rules routing to the HC shared
+    queues are updated.
+    """
+    return _update_saf_enabled(session, request, preview,
+                               is_hc_shared_queue, 'UpdateSAFHC2Basic')
+

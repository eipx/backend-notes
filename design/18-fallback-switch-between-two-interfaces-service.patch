+              help='Enable the SAF rules routing to the selected HC interface')
+@click.option('-D', '--disable', is_flag=True,
+              cls=MutuallyExclusiveOption, mutually_exclusive=['enable'],
+              help='Disable the SAF rules routing to the selected HC interface')
+@click.option('-e', '--env',
+              type=click.Choice(['L', 'T', 'A']),
+              default='A', show_default=True,
+              help='Live(L) or Test(T) or All(A) for services')
+@click.option('--force', is_flag=True,
+              help='Disable the rules even if a route is left without any '
+                   'enabled rule')
+@click.option('--preview', is_flag=True,
+              help='If provided, preview the action to be taken')
+@click.option('--quiet', is_flag=True,
+              help='If provided, do not return affected rules')
+@click.pass_obj
+@logging.process_name('command-update-saf-bridge2grpc')
+@logging.record_cli_event
+def update_saf_bridge2grpc(ctx, orgcode, service, safqueue, interface, enable, disable,
+                         env, force, preview, quiet):
+    """
+    Switch Hosted Connectivity SAF traffic between the gRPC and the BRIDGE interfaces.
+    """
+    try:
+        check_inactive_dr(is_preview=preview)
+        if not enable and not disable:
+            raise INVALID_ARGUMENT('--enable or --disable must be provided.')
+        request= {'orgcode': orgcode,
+                  'enabled': enable,
+                  'interface': interface,
+                  'force': force,
+                  'return_affected_rules': not quiet}
+        if service is not None:
+            request['service_name'] = service
+        if safqueue is not None:
+            request['safqueue'] = safqueue
+        if env == 'L':
+            request['is_test'] = False
+        elif env == 'T':
+            request['is_test'] = True
+        cdb_session = CassandraConnector().connect()
+        response = saf.update_saf_bridge2grpc(cdb_session, request, preview)
+        if not quiet and "rules" in response:
+            logger.status(f'{len(response["rules"])} rules affected')
+            if response['rules']:
+                logger.status('Data after update of enabled flag: ')
+                CassandraModel().tables['TB_SAF'].print_rows(
+                    response['rules'],
+                    columns=['rank', 'receiver', 'org_dn', 'service_name', 'is_test',
+                             'safqueue', 'enabled'])
+        return response
+    except Exception as e:
+        error = format_error(e)
         logger.error(error)
         raise click.ClickException(error)
 
 

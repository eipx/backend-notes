+def update_saf_bridge2grpc(session, request, preview):
+    """
+    Switch HC SAF traffic between the gRPC and the BRIDGE interfaces: without
+    an explicit queue list only the rules routing to the queues of the
+    requested HC interface ('grpc' by default, 'bridge' or 'all') are updated.
+    """
+    interface = request.get('interface', 'grpc')
+    if interface not in HC_INTERFACE_QUEUE_FILTERS:
+        raise INVALID_ARGUMENT(f'Unknown HC interface {interface}')
+    return _update_saf_enabled(session, request, preview,
+                               HC_INTERFACE_QUEUE_FILTERS[interface],
+                               'UpdateSAFBRIDGE2gRPC', check_coverage=True)
